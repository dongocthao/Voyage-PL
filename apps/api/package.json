    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.13.0",
    "@voyage-pnl/shared": "workspace:*",
    "bullmq": "^5.56.7",
    "class-transformer": "^0.5.1",
