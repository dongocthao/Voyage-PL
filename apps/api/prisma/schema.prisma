model actual_voyage_bunker_by_activity {
  id               BigInt                      @id @default(autoincrement())
  actual_voyage_id BigInt
  fuel_type_id     Int                         @db.SmallInt
  activity         actual_consumption_activity
  consumption_mt   Decimal                     @default(0) @db.Decimal(12, 3)
  actual_voyages   actual_voyages              @relation(fields: [actual_voyage_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fuel_types       fuel_types                  @relation(fields: [fuel_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([actual_voyage_id, fuel_type_id, activity], map: "actual_voyage_bunker_by_activ_actual_voyage_id_fuel_type_id_key")
